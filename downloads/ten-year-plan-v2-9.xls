</Styles><Worksheet ss:Name="Overview"><Table><Row><Cell ss:StyleID="Title"><Data ss:Type="String">Ten-Year Plan v2.9 — Public Model Export</Data></Cell><Cell ss:StyleID="Title"><Data ss:Type="String">Current setting/output</Data></Cell><Cell ss:StyleID="Title"><Data ss:Type="String">Notes</Data></Cell></Row><Row><Cell><Data ss:Type="String">Time horizon</Data></Cell><Cell><Data ss:Type="String">2030–2040</Data></Cell><Cell><Data ss:Type="String">Illustrative scenario; not an official government forecast or score.</Data></Cell></Row><Row><Cell><Data ss:Type="String">2040 debt/GDP</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1.0999851591712027</Data></Cell><Cell><Data ss:Type="String">Targeted near 110%.</Data></Cell></Row><Row><Cell><Data ss:Type="String">2040 debt stock</Data></Cell><Cell ss:StyleID="Trillion"><Data ss:Type="Number">63.36011070840642</Data></Cell><Cell><Data ss:Type="String">Nominal trillions.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Mature incremental debt resources</Data></Cell><Cell ss:StyleID="Trillion"><Data ss:Type="Number">0.6025004650415918</Data></Cell><Cell><Data ss:Type="String">Annual resources relative to v2.6.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Cumulative extra debt reduction by 2040</Data></Cell><Cell ss:StyleID="Trillion"><Data ss:Type="Number">5.640663577316567</Data></Cell><Cell><Data ss:Type="String">Relative to v2.6 path.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Lower four income groups</Data></Cell><Cell><Data ss:Type="String">No new v2.9 direct surtax increase</Data></Cell><Cell><Data ss:Type="String">New direct rate changes are concentrated above $250K in this refinement.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Revenue guardrail</Data></Cell><Cell><Data ss:Type="String">~111–112% debt/GDP</Data></Cell><Cell><Data ss:Type="String">Review realization, base design and administration before mechanically increasing rates.</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Policy Parameters"><Table><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Policy</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">v2.9 setting</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Realization</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Model treatment</Data></Cell></Row><Row><Cell><Data ss:Type="String">AGI surtax above $250K</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.075</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.92</Data></Cell><Cell><Data ss:Type="String">Additional surtax layer.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Additional AGI surtax above $1M</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.1</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.92</Data></Cell><Cell><Data ss:Type="String">Additional upper bracket.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Annual wealth tax above $50M</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.05</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1</Data></Cell><Cell><Data ss:Type="String">Retains prior modeled rate.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Annual wealth tax above $250M</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.1</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1</Data></Cell><Cell><Data ss:Type="String">Retains prior modeled rate.</Data></Cell></Row><Row><Cell><Data ss:Type="String">AI levy</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.075</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.95</Data></Cell><Cell><Data ss:Type="String">Illustrative AI-related base.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Capital-gains/dividend rate increase</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.04</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.95</Data></Cell><Cell><Data ss:Type="String">Four-percentage-point increase.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Corporate income-tax rate</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">0.29</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1</Data></Cell><Cell><Data ss:Type="String">29% modeled rate.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Estate/gift exemption per person</Data></Cell><Cell ss:StyleID="Money"><Data ss:Type="Number">7500000</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1</Data></Cell><Cell><Data ss:Type="String">Illustrative exemption.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Additional IRS enforcement funding</Data></Cell><Cell ss:StyleID="Money"><Data ss:Type="Number">7000000000</Data></Cell><Cell><Data ss:Type="String">CBO ROI benchmark used</Data></Cell><Cell><Data ss:Type="String">$7B/year additional funding in the model.</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Debt Path"><Table><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Year</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">GDP ($T)</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">v2.6 debt/GDP</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">v2.9 debt/GDP</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Cumulative extra debt reduction ($T)</Data></Cell></Row><Row><Cell><Data ss:Type="Number">2030</Data></Cell><Cell ss:StyleID="Trillion"><Data ss:Type="Number">37.7140829</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1.0688567</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1.0662417</Data></Cell><Cell ss:StyleID="Trillion"><Data ss:Type="Number">0.0986216</Data></Cell></Row><Row><Cell><Data ss:Type="Number">2031</Data></Cell><Cell ss:StyleID="Trillion"><Data ss:Type="Number">39.288347</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1.0854707</Data></Cell><Cell ss:StyleID="Percent"><Data ss:Type="Number">1.0776301<